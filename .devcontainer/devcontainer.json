{
  "name": "Aconcagua",
  "dockerComposeFile": "docker-compose.yml",
  "service": "aconcagua-tools",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "DavidAnson.vscode-markdownlint",
        "mhutchie.git-graph",
        "timonwong.shellcheck",
        "fnando.linter"
      ],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  },
  "remoteUser": "node"
}
